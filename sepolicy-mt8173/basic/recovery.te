# Purpose : Nand device policy
# Android 12 migration: the equivalent board-specific rules use
# cappu_mtd_device in sepolicy-mtk/basic/plat_private/recovery.te.
allow recovery self:capability sys_resource;

allow recovery system_app_data_file:dir {search };
#allow recovery system_app_data_file:file {read open};

allow recovery vfat:dir *;
allow recovery vfat:file ~{ execute entrypoint };
