# ==============================================
# MTK Policy Rule
# ============

# Date: WK14.52
# Purpose: Drm Key Install
# Android 12 Treble cleanup: this broad legacy access conflicts with system/sepolicy/private/coredomain.te:244; use the owning typed HAL or partition interface instead.
# Disabled legacy grant: allow meta_tst tee_device:chr_file {read write open ioctl};
allow meta_tst provision_file:dir {read write open ioctl add_name search remove_name};
allow meta_tst provision_file:file {create read write open getattr unlink};
#allow meta_tst kisd:unix_stream_socket {connectto};
allow meta_tst shell_exec:file {execute read open execute_no_trans};
# Android 12 migration: these duplicate MTD permissions now live in
# sepolicy-mtk/basic/non_plat/meta_tst.te and use cappu_mtd_device.
