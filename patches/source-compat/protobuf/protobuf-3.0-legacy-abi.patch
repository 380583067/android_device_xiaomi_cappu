diff --git a/Android.bp b/Android.bp
index 6927962..058b21c 100644
--- a/Android.bp
+++ b/Android.bp
@@ -853,3 +853,57 @@ cc_binary_host {
     ],
     stl: "libc++_static",
 }
+
+// cappu runs Android 8 Widevine blobs built against the protobuf 3.0.0 ABI.
+// This private runtime exports only symbols those blobs import, keeping it
+// isolated from the Android 12 platform protobuf implementation.
+cc_library_shared {
+    name: "libprotobuf-cpp-lite-cappu-legacy",
+    vendor: true,
+    srcs: [
+        "cappu_legacy/src/google/protobuf/stubs/atomicops_internals_x86_gcc.cc",
+        "cappu_legacy/src/google/protobuf/stubs/atomicops_internals_x86_msvc.cc",
+        "cappu_legacy/src/google/protobuf/stubs/bytestream.cc",
+        "cappu_legacy/src/google/protobuf/stubs/common.cc",
+        "cappu_legacy/src/google/protobuf/stubs/int128.cc",
+        "cappu_legacy/src/google/protobuf/stubs/once.cc",
+        "cappu_legacy/src/google/protobuf/stubs/status.cc",
+        "cappu_legacy/src/google/protobuf/stubs/statusor.cc",
+        "cappu_legacy/src/google/protobuf/stubs/stringpiece.cc",
+        "cappu_legacy/src/google/protobuf/stubs/stringprintf.cc",
+        "cappu_legacy/src/google/protobuf/stubs/structurally_valid.cc",
+        "cappu_legacy/src/google/protobuf/stubs/strutil.cc",
+        "cappu_legacy/src/google/protobuf/stubs/time.cc",
+        "cappu_legacy/src/google/protobuf/arena.cc",
+        "cappu_legacy/src/google/protobuf/arenastring.cc",
+        "cappu_legacy/src/google/protobuf/extension_set.cc",
+        "cappu_legacy/src/google/protobuf/generated_message_util.cc",
+        "cappu_legacy/src/google/protobuf/message_lite.cc",
+        "cappu_legacy/src/google/protobuf/repeated_field.cc",
+        "cappu_legacy/src/google/protobuf/wire_format_lite.cc",
+        "cappu_legacy/src/google/protobuf/io/coded_stream.cc",
+        "cappu_legacy/src/google/protobuf/io/zero_copy_stream.cc",
+        "cappu_legacy/src/google/protobuf/io/zero_copy_stream_impl_lite.cc",
+    ],
+    local_include_dirs: [
+        "cappu_legacy/android",
+        "cappu_legacy/src",
+    ],
+    cflags: [
+        "-DGOOGLE_PROTOBUF_NO_RTTI",
+        "-Wno-sign-compare",
+        "-Wno-unused-parameter",
+        "-Wno-sign-promo",
+        "-Wno-error=return-type",
+    ],
+    shared_libs: ["liblog"],
+    // Keep ABI-width-specific imports separate: 32-bit size_t mangling differs.
+    target: {
+        android_arm: {
+            version_script: "cappu_legacy32.exports.map",
+        },
+        android_arm64: {
+            version_script: "cappu_legacy64.exports.map",
+        },
+    },
+}
