diff --git a/graphics/composer/2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp b/graphics/composer/2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp
index 3702171..74b243b 100644
--- a/graphics/composer/2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp
+++ b/graphics/composer/2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp
@@ -30,6 +30,7 @@
 #include <sstream>
 
 #include <hardware/hwcomposer.h>
+#include <cutils/properties.h>
 #include <log/log.h>
 #include <utils/Trace.h>
 
@@ -2268,8 +2269,18 @@ void HWC2On1Adapter::populateCapabilities() {
     // Some devices might have HWC1 retire fences that accurately emulate
     // HWC2 present fences when they are deferred, but it's not very reliable.
     // To be safe, we indicate PresentFenceIsNotReliable for all HWC1 devices.
+    //
+    // Mocha (Tegra K1): the NVIDIA GL composer syncs to vblank and its retire
+    // fences are reliable, so trusting them removes tearing. However, trusting
+    // them changes SurfaceFlinger's buffer release timing and this HWC1 blob
+    // then double-unregisters buffers (SIGSEGV in NvGrUnregisterBuffer). Keep
+    // it opt-in behind a property until the blob's buffer lifecycle is fixed.
+    char reliableFences[PROP_VALUE_MAX] = {0};
+    property_get("debug.mocha.reliable_fences", reliableFences, "0");
+    if (atoi(reliableFences) != 1) {
     mCapabilities.insert(Capability::PresentFenceIsNotReliable);
 }
+}
 
 HWC2On1Adapter::Display* HWC2On1Adapter::getDisplay(hwc2_display_t id) {
     std::unique_lock<std::recursive_timed_mutex> lock(mStateMutex);
