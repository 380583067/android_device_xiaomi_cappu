+ * Licensed under the Apache License, Version 2.0
+ */
+
+// Export the historical out-of-line HIDL helper symbol expected by cappu's
+// vendor audio HAL. The generated Android 12 helper has the same behavior but
+// is static inline, so this uniquely named wrapper restores only the old ABI.
+#include <android/hardware/audio/2.0/types.h>
+
+namespace android::hardware::audio::V2_0 {
+
+std::string cappuLegacyToString(Result);
+
+std::string cappuExportToStringResult(Result value)
+        __asm__("_ZN7android8hardware5audio4V2_08toStringENS2_6ResultE");
+std::string cappuExportToStringResult(Result value) {
+    return cappuLegacyToString(value);
+}
+
+}  // namespace android::hardware::audio::V2_0
diff --git a/audio/common/all-versions/default/LegacyAudioCommonAbiCompat.cpp b/audio/common/all-versions/default/LegacyAudioCommonAbiCompat.cpp
new file mode 100644
index 0000000..937e6ed
--- /dev/null
+++ b/audio/common/all-versions/default/LegacyAudioCommonAbiCompat.cpp
@@ -0,0 +1,66 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * Licensed under the Apache License, Version 2.0
+ */
+
+// Android 8's MTK audio implementation imports these helpers from the old
+// android::HidlUtils class. Android 12 moved HidlUtils into the versioned
+// audio.common implementation namespace and added an isInput argument to
+// audioConfigFromHal. Export only the six legacy signatures observed in the
+// cappu blob, forwarding conversions to the current implementation.
+#include "HidlUtils.h"
+
+namespace android {
+
+using ::android::hardware::audio::common::V2_0::AudioConfig;
+using ::android::hardware::audio::common::V2_0::AudioPort;
+using ::android::hardware::audio::common::V2_0::AudioPortConfig;
+using ::android::hardware::hidl_vec;
+
+// This class declaration reproduces only the old out-of-line ABI entrypoints;
+// callers in the current source tree continue using the versioned HidlUtils.
+struct HidlUtils {
+    static status_t audioConfigFromHal(const audio_config_t&, AudioConfig*);
+    static status_t audioConfigToHal(const AudioConfig&, audio_config_t*);
+    static status_t audioPortFromHal(const audio_port&, AudioPort*);
+    static status_t audioPortToHal(const AudioPort&, audio_port*);
+    static status_t audioPortConfigToHal(const AudioPortConfig&, audio_port_config*);
+    static std::unique_ptr<audio_port_config[]> audioPortConfigsToHal(
+            const hidl_vec<AudioPortConfig>&);
+};
+
+status_t HidlUtils::audioConfigFromHal(const audio_config_t& halConfig, AudioConfig* config) {
+    return ::android::hardware::audio::common::V2_0::implementation::HidlUtils::audioConfigFromHal(
+            halConfig, false, config);
+}
+
+status_t HidlUtils::audioConfigToHal(const AudioConfig& config, audio_config_t* halConfig) {
+    return ::android::hardware::audio::common::V2_0::implementation::HidlUtils::audioConfigToHal(
+            config, halConfig);
+}
+
+status_t HidlUtils::audioPortFromHal(const audio_port& halPort, AudioPort* port) {
+    return ::android::hardware::audio::common::V2_0::implementation::HidlUtils::audioPortFromHal(
+            halPort, port);
+}
+
+status_t HidlUtils::audioPortToHal(const AudioPort& port, audio_port* halPort) {
+    return ::android::hardware::audio::common::V2_0::implementation::HidlUtils::audioPortToHal(
+            port, halPort);
+}
+
+status_t HidlUtils::audioPortConfigToHal(const AudioPortConfig& config,
+                                         audio_port_config* halConfig) {
+    return ::android::hardware::audio::common::V2_0::implementation::HidlUtils::audioPortConfigToHal(
+            config, halConfig);
+}
+
+std::unique_ptr<audio_port_config[]> HidlUtils::audioPortConfigsToHal(
+        const hidl_vec<AudioPortConfig>& configs) {
+    std::unique_ptr<audio_port_config[]> halConfigs;
+    (void)::android::hardware::audio::common::V2_0::implementation::HidlUtils::audioPortConfigsToHal(
+            configs, &halConfigs);
+    return halConfigs;
+}
+
+}  // namespace android
