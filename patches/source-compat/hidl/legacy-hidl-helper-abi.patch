+    return toString(value);
+}
+
+std::string cappuLegacyToString(const SetupDataCallResult& value) {
+    return toString(value);
+}
+
+bool cappuLegacyNotEqual(const OperatorInfo& lhs, const OperatorInfo& rhs) {
+    return !(lhs == rhs);
