diff --git a/compat/hidl/debuginfo_compat.cpp b/compat/hidl/debuginfo_compat.cpp
new file mode 100644
index 0000000..36ec3aa
--- /dev/null
+++ b/compat/hidl/debuginfo_compat.cpp
@@ -0,0 +1,35 @@
+/*
+ * Android 8 MTK camera HIDL ABI bridge for DebugInfo's string formatter.
+ *
+ * The generated Android 12 HIDL header keeps this formatter inline, while the
+ * old provider DSO imports its out-of-line C++ ABI symbol. Export that exact
+ * symbol and use the generated DebugInfo fields so both ARM32 and ARM64 blobs
+ * receive the same diagnostic text without changing HIDL transport behavior.
+ */
+#include <android/hidl/base/1.0/types.h>
+
+#include <string>
+
+using android::hidl::base::V1_0::DebugInfo;
+
+__attribute__((visibility("default")))
+std::string cappu_hidl_debuginfo_to_string(const DebugInfo& info)
+        __asm__("_ZN7android4hidl4base4V1_08toStringERKNS2_9DebugInfoE");
+
+std::string cappu_hidl_debuginfo_to_string(const DebugInfo& info) {
+    const char* architecture = "UNKNOWN";
+    switch (info.arch) {
+        case DebugInfo::Architecture::IS_64BIT:
+            architecture = "IS_64BIT";
+            break;
+        case DebugInfo::Architecture::IS_32BIT:
+            architecture = "IS_32BIT";
+            break;
+        case DebugInfo::Architecture::UNKNOWN:
+        default:
+            break;
+    }
+
+    return "{.pid = " + std::to_string(info.pid) + ", .ptr = " +
+            std::to_string(info.ptr) + ", .arch = " + architecture + "}";
+}
diff --git a/compat/legacy-abi/Android.mk b/compat/legacy-abi/Android.mk
new file mode 100644
index 0000000..f5f55ad
--- /dev/null
+++ b/compat/legacy-abi/Android.mk
@@ -0,0 +1,52 @@
+# cappu Android 12 vendor ABI bridge for the remaining ARM32 MTK codecs.
+# Reuse the checkout's compiler-rt implementations of the ARM EABI compare
+# helpers and export them from one vendor library; the old blobs cannot resolve
+# these hidden/compiler-only symbols from Android 12's public libcompiler_rt.
+CAPPU_LEGACY_ABI_PATH := $(call my-dir)
+CAPPU_COMPILER_RT_ARM_PATH := $(TOP)/external/compiler-rt/lib/builtins/arm
+
+LOCAL_PATH := $(CAPPU_COMPILER_RT_ARM_PATH)
+include $(CLEAR_VARS)
+LOCAL_MODULE := libcappu_aeabi_compat
+LOCAL_MODULE_TAGS := optional
+LOCAL_VENDOR_MODULE := true
+LOCAL_MULTILIB := 32
+LOCAL_SRC_FILES := \
+    aeabi_cdcmp.S \
+    aeabi_cfcmp.S \
+    aeabi_cdcmpeq_check_nan.c \
+    aeabi_cfcmpeq_check_nan.c \
+    aeabi_drsub.c
+include $(BUILD_STATIC_LIBRARY)
+
+# Export the EABI archive and device-local MTK compatibility entry points from
+# one vendor DSO so only the legacy blobs that use them depend on this shim.
+LOCAL_PATH := $(CAPPU_LEGACY_ABI_PATH)
+include $(CLEAR_VARS)
+LOCAL_MODULE := libcappu_legacy_abi
+LOCAL_MODULE_TAGS := optional
+LOCAL_VENDOR_MODULE := true
+LOCAL_MULTILIB := 32
+LOCAL_SRC_FILES := \
+    pthread_compat.cpp \
+    xlog_compat.cpp
+LOCAL_WHOLE_STATIC_LIBRARIES := libcappu_aeabi_compat
+# Android 12 marks libcompiler_rt.vendor as VNDK-private, so a vendor module
+# must not link to it. The legacy AEABI entry points needed by cappu blobs are
+# already compiled into libcappu_aeabi_compat and whole-archived above; keep
+# only liblog here for the xlog compatibility wrapper.
+LOCAL_SHARED_LIBRARIES := liblog
+include $(BUILD_SHARED_LIBRARY)
+
+LOCAL_PATH := $(CAPPU_LEGACY_ABI_PATH)
+
+# Android 8 MTK camera blobs use MemoryHeapBase(fd, size, flags, uint32_t);
+# Android 12 exports only the off_t overload, so ship a tiny vendor-side bridge.
+include $(CLEAR_VARS)
+LOCAL_MODULE := libcappu_memory_heap_base_compat
+LOCAL_MODULE_TAGS := optional
+LOCAL_VENDOR_MODULE := true
+LOCAL_MULTILIB := both
+LOCAL_SRC_FILES := memory_heap_base_compat.cpp
+LOCAL_SHARED_LIBRARIES := libbinder libc++
+include $(BUILD_SHARED_LIBRARY)
diff --git a/compat/legacy-abi/memory_heap_base_compat.cpp b/compat/legacy-abi/memory_heap_base_compat.cpp
new file mode 100644
index 0000000..879938e
--- /dev/null
+++ b/compat/legacy-abi/memory_heap_base_compat.cpp
@@ -0,0 +1,33 @@
+/*
+ * Bridge the Android 8 MemoryHeapBase constructor used by MTK camera blobs.
+ * Android 12 changed only its fourth parameter from uint32_t to off_t. Export
+ * the exact old ARM/ARM64 mangled constructor entry and forward its zero-
+ * extended offset to the current public libbinder constructor.
+ */
+#include <binder/MemoryHeapBase.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <new>
+#include <sys/types.h>
+
+#if defined(__LP64__)
+#define CAPPU_LEGACY_MEMORY_HEAP_BASE_CTOR "_ZN7android14MemoryHeapBaseC1Eimjj"
+#else
+#define CAPPU_LEGACY_MEMORY_HEAP_BASE_CTOR "_ZN7android14MemoryHeapBaseC1Eijjj"
+#endif
+
+extern "C" __attribute__((visibility("default")))
+void cappu_legacy_memory_heap_base_ctor(android::MemoryHeapBase* storage,
+        int fd, size_t size, uint32_t flags, uint32_t offset)
+        __asm__(CAPPU_LEGACY_MEMORY_HEAP_BASE_CTOR);
+
+extern "C" __attribute__((visibility("default")))
+void cappu_legacy_memory_heap_base_ctor(android::MemoryHeapBase* storage,
+        int fd, size_t size, uint32_t flags, uint32_t offset) {
+    // The old offset was unsigned 32-bit, so preserve its value when widened.
+    ::new (static_cast<void*>(storage)) android::MemoryHeapBase(
+            fd, size, flags, static_cast<off_t>(offset));
+}
+
+#undef CAPPU_LEGACY_MEMORY_HEAP_BASE_CTOR
diff --git a/compat/legacy-abi/pthread_compat.cpp b/compat/legacy-abi/pthread_compat.cpp
new file mode 100644
index 0000000..c87fb1e
--- /dev/null
+++ b/compat/legacy-abi/pthread_compat.cpp
@@ -0,0 +1,20 @@
+/*
+ * Android 8 MTK decoder ABI bridge for Bionic's private __pthread_gettid.
+ *
+ * Bionic's compatibility implementation has the same pthread_t-to-tid
+ * behavior but is no longer present in the public libc link interface. Keep
+ * this old import device-local and forward it to the public API introduced in
+ * Android 5; blob-fixups removes only this symbol's stale LIBC_PRIVATE version
+ * requirement so the runtime linker resolves it from this vendor shim.
+ */
+#include <pthread.h>
+#include <sys/types.h>
+
+extern "C" __attribute__((visibility("default")))
+pid_t cappu_legacy_pthread_gettid(pthread_t thread)
+        __asm__("__pthread_gettid");
+
+extern "C" __attribute__((visibility("default")))
+pid_t cappu_legacy_pthread_gettid(pthread_t thread) {
+    return pthread_gettid_np(thread);
+}
diff --git a/compat/legacy-abi/xlog_compat.cpp b/compat/legacy-abi/xlog_compat.cpp
new file mode 100644
index 0000000..76fba90
--- /dev/null
+++ b/compat/legacy-abi/xlog_compat.cpp
@@ -0,0 +1,29 @@
+/*
+ * Device-local Android 12 compatibility for the legacy MTK xlog entry point.
+ * The old xlog ABI passes its tag, format string, and priority in xlog_record;
+ * forward the same varargs through Android's supported liblog API.
+ */
+#include <android/log.h>
+
+#include <stdarg.h>
+
+struct xlog_record {
+    const char* tag_str;
+    const char* fmt_str;
+    int prio;
+};
+
+extern "C" int __xlog_buf_printf(int bufid, const struct xlog_record* record,
+        ...) {
+    (void)bufid;
+    if (record == nullptr || record->tag_str == nullptr || record->fmt_str == nullptr) {
+        return -1;
+    }
+
+    va_list args;
+    va_start(args, record);
+    const int result = __android_log_vprint(record->prio, record->tag_str,
+            record->fmt_str, args);
+    va_end(args);
+    return result;
+}
diff --git a/compat/libpixelflinger/Android.mk b/compat/libpixelflinger/Android.mk
new file mode 100644
index 0000000..7b28af3
--- /dev/null
+++ b/compat/libpixelflinger/Android.mk
@@ -0,0 +1,101 @@
+# cappu Android 12：MTK libccap 仍使用完整 libpixelflinger API，平台已移除此库。
+# 从 LineageOS system/core lineage-15.1 导入原实现，保留原许可，仅供本设备 vendor。
+# 不使用空壳绕过符号错误，也不恢复平台全局模块或旧测试程序。
+LOCAL_PATH:= $(call my-dir)
+include $(CLEAR_VARS)
+
+#
+# C/C++ and ARMv5 objects
+#
+
+include $(CLEAR_VARS)
+PIXELFLINGER_SRC_FILES:= \
+	codeflinger/ARMAssemblerInterface.cpp \
+	codeflinger/ARMAssemblerProxy.cpp \
+	codeflinger/CodeCache.cpp \
+	codeflinger/GGLAssembler.cpp \
+	codeflinger/load_store.cpp \
+	codeflinger/blending.cpp \
+	codeflinger/texturing.cpp \
+	format.cpp \
+	clear.cpp \
+	raster.cpp \
+	buffer.cpp
+
+PIXELFLINGER_CFLAGS := -fstrict-aliasing -fomit-frame-pointer
+
+PIXELFLINGER_SRC_FILES_arm := \
+	codeflinger/ARMAssembler.cpp \
+	codeflinger/disassem.c \
+	col32cb16blend.S \
+	t32cb16blend.S \
+
+ifeq ($(ARCH_ARM_HAVE_NEON),true)
+PIXELFLINGER_SRC_FILES_arm += col32cb16blend_neon.S
+PIXELFLINGER_CFLAGS_arm += -D__ARM_HAVE_NEON
+endif
+
+PIXELFLINGER_SRC_FILES_arm64 := \
+	codeflinger/Arm64Assembler.cpp \
+	codeflinger/Arm64Disassembler.cpp \
+	arch-arm64/col32cb16blend.S \
+	arch-arm64/t32cb16blend.S \
+
+# Android 8 selected these five translation units with the legacy `.cpp.arm`
+# suffix, which forced ARM instruction mode per file. Android 12 rejects that
+# suffix, so compile the same files in a dedicated 32-bit static library whose
+# LOCAL_ARM_MODE preserves the old code-generation requirement. Keep it out of
+# the arm64 link and attach it only to libpixelflinger's ARM variant below.
+PIXELFLINGER_ARM_MODE_SRC_FILES := \
+	fixed.cpp \
+	picker.cpp \
+	pixelflinger.cpp \
+	trap.cpp \
+	scanline.cpp
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libpixelflinger_arm
+LOCAL_VENDOR_MODULE := true
+LOCAL_MULTILIB := 32
+LOCAL_ARM_MODE := arm
+LOCAL_SRC_FILES := $(PIXELFLINGER_ARM_MODE_SRC_FILES)
+LOCAL_CFLAGS := $(PIXELFLINGER_CFLAGS)
+# 这个 ARM 模式静态库单独编译旧版 pixelflinger 源文件，不会继承下方
+# libpixelflinger 共享库依赖导出的头文件路径；显式加入 Android 12 的
+# libutils 和 liblog 头文件目录，供 CodeCache.h、trap.cpp、scanline.cpp 使用。
+LOCAL_C_INCLUDES += $(LOCAL_PATH)/include external/safe-iop/include \
+		    system/core/libutils/include \
+		    system/logging/liblog/include
+include $(BUILD_STATIC_LIBRARY)
+
+# BUILD_STATIC_LIBRARY consumes and leaves LOCAL_* module variables behind;
+# reset them before defining the shared library so Kati registers it separately.
+include $(CLEAR_VARS)
+
+# cappu's Android 12 product is ARM64 with a 32-bit ARM secondary ABI.
+# The original Android 8 pixelflinger makefile also carried MIPS branches, but
+# current build/make marks ARCH_MIPS_REV6 obsolete and rejects evaluating it
+# even when MIPS is not selected. Keep only the device's actual ARM sources.
+#
+# Shared library
+#
+
+LOCAL_MODULE:= libpixelflinger
+LOCAL_VENDOR_MODULE := true
+LOCAL_MULTILIB := both
+LOCAL_SRC_FILES := $(PIXELFLINGER_SRC_FILES)
+LOCAL_SRC_FILES_arm := $(PIXELFLINGER_SRC_FILES_arm)
+LOCAL_SRC_FILES_arm64 := $(PIXELFLINGER_SRC_FILES_arm64)
+# The 64-bit build compiles the former `.cpp.arm` files normally; ARM32 links
+# the dedicated ARM-mode archive above, preventing duplicate definitions.
+LOCAL_SRC_FILES_64 := $(PIXELFLINGER_ARM_MODE_SRC_FILES)
+LOCAL_STATIC_LIBRARIES_32 := libpixelflinger_arm
+LOCAL_CFLAGS := $(PIXELFLINGER_CFLAGS)
+LOCAL_EXPORT_C_INCLUDE_DIRS := $(LOCAL_PATH)/include
+LOCAL_C_INCLUDES += $(LOCAL_EXPORT_C_INCLUDE_DIRS) \
+		    external/safe-iop/include
+LOCAL_SHARED_LIBRARIES := libcutils liblog libutils
+
+include $(BUILD_SHARED_LIBRARY)
+
+
