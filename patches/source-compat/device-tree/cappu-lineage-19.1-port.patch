diff --git a/sepolicy-mtk/bsp/non_plat/zz_cappu_legacy_property_compat.te b/sepolicy-mtk/bsp/non_plat/zz_cappu_legacy_property_compat.te
new file mode 100644
index 0000000..9c9c0fa
--- /dev/null
+++ b/sepolicy-mtk/bsp/non_plat/zz_cappu_legacy_property_compat.te
@@ -0,0 +1,7 @@
+# Android 12 neverallows restrict legacy system-domain writes to vendor
+# properties. ril-3gddaemon is declared in this vendor policy tree but runs as
+# a legacy system-side service, so keep its existing compatibility exception
+# beside the type after all basic/BSP domain declarations have been parsed.
+# This attribute does not grant property access; its existing property rules
+# remain the only grants and Treble restrictions on vendor domains stay active.
+typeattribute ril-3gddaemon system_writes_vendor_properties_violators;
diff --git a/rootdir/etc/init/init.cappu-usb-default.rc b/rootdir/etc/init/init.cappu-usb-default.rc
new file mode 100644
--- /dev/null
+++ b/rootdir/etc/init/init.cappu-usb-default.rc
@@ -0,0 +1,7 @@
+# cappu 的旧 android_usb gadget 在开机早期可按 persist.sys.usb.config 枚举，
+# 但 Android 12 UsbDeviceManager 会在 finishBoot() 恢复“解锁后 USB 功能”偏好；
+# 全新用户数据没有该偏好时，系统主动回退到充电/ADB，覆盖设备树的 MTP 默认值。
+# post-fs-data 早于 system_server 启动，因此在此处仅初始化缺失的偏好文件，
+# 让系统服务按其正常锁屏策略启用 MTP；已有文件绝不覆盖，保留用户后续选择。
+on post-fs-data
+    exec -- /system/bin/sh /vendor/bin/cappu-usb-default.sh
diff --git a/rootdir/etc/init/cappu-usb-default.sh b/rootdir/etc/init/cappu-usb-default.sh
new file mode 100755
--- /dev/null
+++ b/rootdir/etc/init/cappu-usb-default.sh
@@ -0,0 +1,34 @@
+#!/system/bin/sh
+
+# Android 12 UsbDeviceManager stores the screen-unlocked USB function choice
+# in this device-protected SharedPreferences file. Seed only a missing file:
+# a pre-existing file represents the user's saved choice and must never be
+# overwritten by a later OTA or reboot.
+PREFS=/data/system_de/0/UsbDeviceManagerPrefs.xml
+TEMP=${PREFS}.cappu-tmp
+
+if [ -e "$PREFS" ]; then
+    exit 0
+fi
+
+# On a clean userdata image Android may not have created the system-user DE
+# subdirectory yet. Build it with the same owner/mode and inherited DE label.
+/system/bin/mkdir -p /data/system_de/0 || exit 1
+/system/bin/chown system:system /data/system_de/0 || exit 1
+/system/bin/chmod 0770 /data/system_de/0 || exit 1
+/system/bin/restorecon /data/system_de/0 || exit 1
+
+# Write atomically before system_server starts reading the preferences. The
+# file uses the same key and value as UsbDeviceManager.setScreenUnlockedFunctions.
+umask 077
+/system/bin/printf '%s\n' \
+    '<?xml version="1.0" encoding="utf-8" standalone="yes" ?>' \
+    '<map>' \
