 $(call inherit-product, $(SRC_TARGET_DIR)/product/full_base.mk)
 
@@ -30,6 +43,16 @@ PRODUCT_DEFAULT_PROPERTY_OVERRIDES += \
     ro.oem_unlock_supported=1 \
