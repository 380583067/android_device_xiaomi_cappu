+++ b/sepolicy-mtk/basic/plat_public/cappu_mtd_device.te
@@ -0,0 +1,5 @@
+# cappu Android 12 compatibility type: AOSP 12 no longer exports the generic
+# MTK mtd_device label. Export a board-owned device type so the retained MTK
