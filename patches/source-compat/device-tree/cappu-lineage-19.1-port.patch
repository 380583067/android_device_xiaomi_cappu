diff --git a/compat/graphics/fence_compat.cpp b/compat/graphics/fence_compat.cpp
new file mode 100644
index 0000000..403fa8c
--- /dev/null
+++ b/compat/graphics/fence_compat.cpp
@@ -0,0 +1,33 @@
+/*
+ * Device-local Android 12 compatibility for the Android 8 MTK video encoder.
+ *
+ * libMtkOmxVenc.so still imports android::Fence::~Fence() (the ARM32 Itanium
+ * ABI D1 entry point). Android 12 made Fence's destructor inline/defaulted,
+ * so libui no longer exports that old dynamic symbol. Keep the encoder's real
+ * destruction behavior by closing the fd owned by Fence's base::unique_fd;
+ * LightRefBase's destructor is empty and Flattenable has no instance state.
+ * Export the old mangled entry point from this shim so ELF checks and the
+ * runtime linker both resolve it without allowing other missing symbols.
+ */
+#include <ui/Fence.h>
+
+#include <unistd.h>
+
+extern "C" __attribute__((visibility("default")))
+void cappu_legacy_fence_d1(android::Fence* fence)
+        __asm__("_ZN7android5FenceD1Ev");
+
+extern "C" __attribute__((visibility("default")))
+void cappu_legacy_fence_d1(android::Fence* fence) {
+    if (fence == nullptr) {
+        return;
+    }
+
+    const int fd = fence->get();
+    if (fd >= 0) {
+        // Fence's Android 12 member destructor performs this close through
+        // base::unique_fd; the object storage and reference count stay owned
+        // by the caller's existing destruction path.
+        (void)::close(fd);
+    }
+}
diff --git a/compat/graphics/graphic_buffer_compat.cpp b/compat/graphics/graphic_buffer_compat.cpp
new file mode 100644
index 0000000..ac11b94
--- /dev/null
+++ b/compat/graphics/graphic_buffer_compat.cpp
@@ -0,0 +1,24 @@
+/*
+ * Android 8 MTK camera ABI bridge for GraphicBuffer::lock(uint32_t, void**).
+ *
+ * Android 12 adds optional stride and pixel-size outputs to the exported
+ * overload. The camera client does not request those values, so preserve the
+ * old mangled entry point and forward to the current overload with null output
+ * pointers. This keeps the existing buffer mapper and gralloc behavior intact.
+ */
+#include <ui/GraphicBuffer.h>
+
+extern "C" __attribute__((visibility("default")))
+android::status_t cappu_legacy_graphic_buffer_lock(
+        android::GraphicBuffer* buffer, uint32_t usage, void** vaddr)
+        __asm__("_ZN7android13GraphicBuffer4lockEjPPv");
+
+extern "C" __attribute__((visibility("default")))
+android::status_t cappu_legacy_graphic_buffer_lock(
+        android::GraphicBuffer* buffer, uint32_t usage, void** vaddr) {
+    if (buffer == nullptr || vaddr == nullptr) {
+        return android::BAD_VALUE;
+    }
+
+    return buffer->lock(usage, vaddr, nullptr, nullptr);
+}
diff --git a/compat/graphics/graphics_mapper_compat.cpp b/compat/graphics/graphics_mapper_compat.cpp
new file mode 100644
index 0000000..2522f24
--- /dev/null
+++ b/compat/graphics/graphics_mapper_compat.cpp
@@ -0,0 +1,26 @@
+/*
+ * Android 8 MTK decoder ABI bridge for GraphicBufferMapper::lock.
+ *
+ * Android 12 added the optional output-stride arguments to this method, which
+ * changes its mangled symbol even though the original operation remains. The
+ * decoder only requests the mapped address, so forward its old entry point to
+ * the current libui overload with both optional outputs omitted.
+ */
+#include <ui/GraphicBufferMapper.h>
+
+extern "C" __attribute__((visibility("default")))
+android::status_t cappu_legacy_graphic_buffer_mapper_lock(
+        android::GraphicBufferMapper* mapper, buffer_handle_t handle,
+        uint32_t usage, const android::Rect* bounds, void** vaddr)
+        __asm__("_ZN7android19GraphicBufferMapper4lockEPK13native_handlejRKNS_4RectEPPv");
+
+extern "C" __attribute__((visibility("default")))
+android::status_t cappu_legacy_graphic_buffer_mapper_lock(
+        android::GraphicBufferMapper* mapper, buffer_handle_t handle,
+        uint32_t usage, const android::Rect* bounds, void** vaddr) {
+    if (mapper == nullptr || bounds == nullptr || vaddr == nullptr) {
+        return android::BAD_VALUE;
+    }
+
+    return mapper->lock(handle, usage, *bounds, vaddr, nullptr, nullptr);
+}
