diff --git a/compat/vintf/kernel-3.18/Android.bp b/compat/vintf/kernel-3.18/Android.bp
new file mode 100644
index 0000000..30fe1f7
--- /dev/null
+++ b/compat/vintf/kernel-3.18/Android.bp
@@ -0,0 +1,12 @@
+// cappu Android 12 migration note: the platform's kernel/configs checkout only
+// carries P and newer configs, but this device still runs the Android O-MR1
+// 3.18 kernel. Keep the official O-MR1 requirements as a local module so FCM 2
+// is assembled with its real kernel constraints instead of weakening VINTF.
+kernel_config {
+    name: "cappu_kernel_config_o_mr1_3.18",
+    srcs: [
+        "android-base.config",
+        "android-base-arm64.config",
+    ],
+    meta: "android-base-conditional.xml",
+}
diff --git a/compat/vintf/kernel-3.18/README.md b/compat/vintf/kernel-3.18/README.md
new file mode 100644
index 0000000..dacf051
--- /dev/null
+++ b/compat/vintf/kernel-3.18/README.md
@@ -0,0 +1 @@
+These kernel requirements are copied unchanged from the official Android kernel/configs repository at tag `android-11.0.0_r46`, path `o-mr1/android-3.18/`. The module name is prefixed with `cappu_` to avoid colliding with platform modules. Android 12 no longer ships O-MR1 kernel configs, while cappu's 3.18 kernel still needs this FCM 2 metadata.
