<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        cappu 当前网络的实测结果：默认 https://www.google.com/generate_204 在
        NetworkMonitor 中超时；https://connectivitycheck.gstatic.com/generate_204
        可在同一网络返回 HTTP 204 且 TLS 校验通过。原来的验证失败会产生
        PARTIAL_CONNECTIVITY / “网络受限”提示，并导致保存网络被标记为
        NO_INTERNET_PERMANENT，后续自动连接因此跳过它。

        这里只替换 NetworkStack 提供的 OEM 配置资源，不关闭验证、不伪造验证成功，
        也不改动 Android 的 HTTP 门户检测和用户门户登录流程。
    -->
    <string name="config_captive_portal_https_url" translatable="false">https://connectivitycheck.gstatic.com/generate_204</string>

    <!--
        仅在主 HTTP/HTTPS 探测无法判定时用于回退门户检测。
        此 URL 已在 cappu 当前网络实测可达并返回 204。
    -->
    <string-array name="config_captive_portal_fallback_urls" translatable="false">
        <item>http://connect.rom.miui.com/generate_204</item>
    </string-array>
</resources>
