# ==============================================
# Policy File of /system/bin/GoogleOtaBinder Executable File 


# ==============================================
# Type Declaration
# ==============================================

# Android 12 Treble: matching file_contexts labels a /system path; mark this executable as system_file_type so coredomain entrypoints remain in the system partition.
type GoogleOtaBinder_exec , system_file_type, exec_type, file_type;
typeattribute GoogleOtaBinder coredomain;

# ==============================================
# Android Policy Rule
# ==============================================

# ==============================================
# NSA Policy Rule
# ==============================================

# ==============================================
# MTK Policy Rule
# ==============================================

#permissive GoogleOtaBinder;
init_daemon_domain(GoogleOtaBinder)
#unconfined_domain(GoogleOtaBinder)

# Date : 2014/09/10
# Operation : Migration
# Purpose : allow Binder IPC
binder_use(GoogleOtaBinder)
binder_service(GoogleOtaBinder)

allow GoogleOtaBinder block_device:dir search;
#for kmsg
allow GoogleOtaBinder kmsg_device:chr_file { write read open ioctl};
#for nand
# cappu Android 12: the old MTK mtd_device type was removed; use the exported board type for legacy rules and labels.
allow GoogleOtaBinder cappu_mtd_device:dir search;
allow GoogleOtaBinder cappu_mtd_device:chr_file { read write open rw_file_perms};
#to get offset
allow GoogleOtaBinder ota_package_file:dir search;
allow GoogleOtaBinder ota_package_file:file { getattr open read write };
# Android 12 neverallows DAC-bypass capabilities and broad coredomain proc/sysfs
# access. This legacy OTA helper must use explicit exported labels if reinstated.

