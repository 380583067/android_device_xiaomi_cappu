# ==============================================
# MTK Policy Rule
# ==============================================

# Date : WK15.02
# Purpose : fsck_msdos
allow vold platform_app:fd use;

#install APK move to SD
allow vold block_device:file create;

#Date : WK15.11
# cappu Android 12: the old MTK mtd_device type was removed; use the exported board type for legacy rules and labels.
allow vold cappu_mtd_device:dir search;
allow vold cappu_mtd_device:chr_file { read write open };

# Date : WK17.28
# Purpose : write bootprof
# Android 12 forbids unrestricted /proc writes from coredomains; retain only
# device-specific storage labels and platform interfaces for vold.

# Date : WK17.28
# Purpose : encrypt phone
allow vold kernel:system module_request;
