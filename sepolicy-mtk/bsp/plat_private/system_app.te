# ==============================================
# MTK Policy Rule
# =================

# Date: 2014/08/21
# Stage: BaseUT
# Purpose: connect to native atci_service
# Package Name: com.mediatek.atci.service
allow system_app atci_serv_fw_socket:sock_file write;
allow system_app atci_service:unix_stream_socket connectto;

# cappu Android 12: the platform no longer creates /dev/socket/netd; the
# retired MTK ATCI NSIOT path used that pre-Binder endpoint, so drop its grant.

# Android 12 reserves net_dns_prop writes for the platform network stack; the
# legacy ATCI system app no longer receives broad DNS property access.

# The Android 7 MDM app/property path is not shipped by this cappu vendor tree.

# Date : 2016.02.20
# Operation: MID_ShiYouHui
# Purpose: for gsensor calibration
# Package: com.mid.gsensorcali
allow system_app em_svr:unix_stream_socket connectto;
# Android 12 forbids generic sysfs access from system_app; use a specific HAL or
# exported sysfs type if the calibration app is reintroduced.
