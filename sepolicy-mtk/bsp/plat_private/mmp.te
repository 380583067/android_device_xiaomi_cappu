# ==============================================
# Policy File of /system/bin/mmp Executable File 


# ==============================================
# Type Declaration
# ==============================================

# Android 12 Treble: matching file_contexts labels a /system path; mark this executable as system_file_type so coredomain entrypoints remain in the system partition.
type mmp_exec , system_file_type, exec_type, file_type;
type mmp ,domain;

typeattribute mmp coredomain;

# ==============================================
# Android Policy Rule
# ==============================================

# ==============================================
# NSA Policy Rule
# ==============================================

# ==============================================
# MTK Policy Rule
# ==============================================

init_daemon_domain(mmp)

