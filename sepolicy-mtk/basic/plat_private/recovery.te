# Purpose : Nand device policy
# cappu Android 12: the old MTK mtd_device type was removed; use the exported board type for legacy rules and labels.
allow recovery cappu_mtd_device:dir search;
allow recovery cappu_mtd_device:chr_file { read write open ioctl getattr };
allow recovery self:capability sys_resource;

allow recovery system_app_data_file:dir {search };
#allow recovery system_app_data_file:file {read open};
