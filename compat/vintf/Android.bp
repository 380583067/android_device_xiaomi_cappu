// cappu Android 12：平台删除了 FCM 2，但仍保留 audio 2.0 等旧接口客户端。
// 设备内恢复对应官方矩阵及 3.18 内核要求，使用平台工具校验和安装；
// 不关闭 VINTF 检查，不修改所有设备共用的框架矩阵。
vintf_compatibility_matrix {
    name: "cappu_framework_compatibility_matrix.2.xml",
    stem: "compatibility_matrix.2.xml",
    srcs: ["compatibility_matrix.2.xml"],
    kernel_configs: ["cappu_kernel_config_o_mr1_3.18"],
}
