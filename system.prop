#
# system.prop for mtk8176 (mtk8173) Cappu
#

rild.libpath=mtk-ril.so
rild.libargs=-d /dev/ttyC0

# audio
ro.camera.sound.forced=0
ro.audio.silent=0

# MTK, Infinity, 20090720 {
wifi.interface=wlan0
# MTK, Infinity, 20090720 }
# MTK, mtk03034, 20101210 {
ro.mediatek.wlan.wsc=1
# MTK, mtk03034 20101210}
# MTK, mtk03034, 20110318 {
ro.mediatek.wlan.p2p=1
# MTK, mtk03034 20110318}
# MTK, mtk03034, 20101213 {
mediatek.wlan.ctia=0
# MTK, mtk03034 20101213}
#
wifi.tethering.interface=ap0
wifi.direct.interface=p2p0

# --- 核心图形驱动加载 ---
ro.hardware.egl=mtk
ro.hardware.gralloc=mt8173
ro.hardware.hwcomposer=mt8173
ro.board.platform=mt8173
ro.mediatek.platform=MT8173

# --- HWC2 与 渲染器设置 ---
ro.surfaceflinger.use_hwc2=true
ro.opengles.version=196610
debug.hwui.renderer=opengl
ro.zygote.disable_gl_preload=true

# --- 屏幕与性能优化 ---
ro.sf.lcd_density=320
debug.sf.disable_backpressure=1
debug.sf.latch_unsignaled=1
debug.sf.hwc_hotplug_error_check=1

# --- 兼容性补丁 ---
ro.kernel.ebpf.supported=false
ro.config.avoid_gfx_accel=false

# USB MTP WHQL
ro.sys.usb.mtp.whql.enable=0

# Power off opt in IPO
sys.ipo.pwrdncap=2

ro.sys.usb.storage.type=mtp

# USB BICR function
ro.sys.usb.bicr=no

# USB Charge only function
ro.sys.usb.charging.only=yes

ro.zygote.preload.enable=0

# temporary enables NAV bar (soft keys)
qemu.hw.mainkeys=1

# Kernel Selinux
ro.kernel.zio=38,108,105,16
ro.boot.selinux=disable

# performance
ro.mtk_perf_simple_start_win=1
ro.mtk_perf_response_time=1
# factory mode config
sys.mtk.no.factoryimage=1
# disable ipo for development
sys.ipo.disable=1
# HMDI 4K setting UI config
ro.mtk_hdmi_4k_support=1

#
# ADDITIONAL_BUILD_PROPERTIES
#
pm.boot.disable_package_cache=1
ro.product.first_api_level=24
persist.sys.mcd_config_file=/system/etc/mcd_default.conf
ro.carrier=unknown
ro.btconfig.if=uart
ro.btconfig.dev=/dev/ttyMT1
ro.btconfig.vendor=broadcom
ro.btconfig.chip=BCM4356
ro.mediatek.platform=MT8173
ro.mediatek.chip_ver=S01
ro.mtk_key_manager_kb_path=1
ril.specific.sm_cause=0
ro.sf.hwrotation=0
persist.radio.fd.counter=150
persist.radio.fd.off.counter=50
persist.radio.fd.r8.counter=150
persist.radio.fd.off.r8.counter=50
drm.service.enabled=true
mtk_in_house_tee_support=true
fmradio.driver.enable=0
ril.first.md=1
ril.flightmode.poweroffMD=0
ril.telephony.mode=0
dalvik.vm.mtk-stack-trace-file=/data/anr/mtk_traces.txt
mediatek.wlan.chip=MT6630
mediatek.wlan.module.postfix=_mt6630
ril.radiooff.poweroffMD=0
ro.frp.pst=/dev/block/platform/mtk-msdc.0/11230000.MSDC0/by-name/frp
ro.mtk_protocol1_rat_config=no
ro.mtk_support_mp2_playback=1
ro.mediatek.version.branch=alps-mp-n0.mp12.tc8sp
ro.mediatek.version.release=alps-mp-n0.mp12.tc8sp
ro.mediatek.version.sdk=4
ro.num_md_protocol=2
ro.mtk_besloudness_support=1
ro.mtk_wappush_support=1
ro.mtk_audio_tuning_tool_ver=V1
ro.mtk_wlan_support=1
ro.mtk_omacp_support=1
ro.mtk_dhcpv6c_wifi=1
ro.have_aacencode_feature=1
ro.mtk_fd_support=1
ro.mtk_oma_drm_support=1
ro.mtk_cta_drm_support=1
ro.mtk_widevine_drm_l3_support=1
ro.mtk_eap_sim_aka=1
ro.mtk_flv_playback_support=1
ro.mtk_wmv_playback_support=1
ro.mtk_send_rr_support=1
ro.mtk_emmc_support=1
ro.mtk_tetheringipv6_support=1
ro.telephony.default_network=0
ro.mtk_shared_sdcard=1
ro.mtk_aal_support=1
ro.mtk_ultra_dimming_support=1
ro.mtk_pq_support=2
ro.mtk_pq_color_mode=1
ro.mtk_miravision_support=1
ro.mtk_blulight_def_support=1
ro.mtk_wifi_mcc_support=1
ro.mtk_sim_hot_swap=1
ro.mtk_bip_scws=1
ro.mtk_wfd_hdcp_tx_support=1
ro.mtk_world_phone_policy=0
ro.mtk_perfservice_support=1
ro.mtk_cta_set=1
ro.mtk_key_manager_support=1
ro.mtk_cam_mfb_support=0
ro.mtk_cam_cfb=1
ro.mtk_cam_vfb=1
ro.mtk_external_sim_only_slots=0
ro.mtk_bg_power_saving_support=1
ro.mtk_bg_power_saving_ui=1
ro.have_aee_feature=1
ro.sim_me_lock_mode=0
ro.mtk_dual_mic_support=0
persist.mtk_vilte_support=0
ro.mtk_vilte_ut_support=0
wfd.dummy.enable=0
wfd.iframesize.level=0
ro.mediatek.project.path=device/xiaomi/cappu
ro.mtk_sec_video_path_support=1
persist.mtk.wcn.combo.chipid=-1
persist.mtk.wcn.patch.version=-1
persist.mtk.wcn.dynamic.dump=0
service.wcn.driver.ready=no
service.wcn.coredump.mode=0
persist.mtk.connsys.poweron.ctl=0
persist.radio.mobile.data=0,0
persist.meta.dumpdata=0
persist.radio.mtk_ps2_rat=G
persist.radio.mtk_ps3_rat=G
ro.boot.opt_c2k_lte_mode=0
persist.log.tag.RIL-DATA=D
ro.boot.opt_using_default=1
ro.mtk_multiwindow=1
mtk.vdec.waitkeyframeforplay=1
ro.sys.sdcardfs=1
ro.media.maxmem=500000000
persist.sys.aal.function=4
ro.malloc.impl=jemalloc
net.bt.name=Android
fw.max_users=5
ro.com.android.mobiledata=false
ro.product.manufacturer=Xiaomi
ro.com.android.dataroaming=false
persist.sys.mitalk.enable=true
persist.enable_task_snapshots=false
persist.sys.watchdog_enhanced=true
persist.power.useautobrightadj=true
persist.radio.apm_sim_not_pwdn=1

# A10
sys.boot_completed=0
dev.bootcomplete=0
service.nvram_init=0
persist.sys.strictmode.disable=1

# Default.prop
ro.oem_unlock_supported=1
ro.mount.fs=EXT4
camera.disable_zsl_mode=1

# Tethering
net.tethering.noprovisioning=true

ro.crypto.state=unencrypted
